FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache git

# Clone repository
RUN git clone https://github.com/ugonkwocha/pairwise-budgeting-app.git . && \
    git log -1 --oneline

# Install dependencies (production only)
RUN npm install --omit=dev

# Expose port for Prisma Studio
EXPOSE 5555

# Push schema to database directly, then start Prisma Studio
# The DATABASE_URL environment variable must be set when running this container
CMD ["sh", "-c", "npx prisma db push --skip-generate && echo '✅ Schema pushed to database!' && npx prisma studio --browser none"]
