FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache git

# Clone repository
RUN git clone https://github.com/ugonkwocha/pairwise-budgeting-app.git .

# Install dependencies (includes prisma in dependencies, not devDependencies)
RUN npm install --omit=dev

# Push database schema to PostgreSQL
# The DATABASE_URL environment variable must be provided at runtime
# Exits successfully when schema is pushed
CMD ["npx", "prisma", "db", "push", "--accept-data-loss"]
