FROM node:20-alpine

WORKDIR /app

RUN apk add --no-cache git

# Clone repository
RUN git clone https://github.com/ugonkwocha/pairwise-budgeting-app.git . && \
    git log -1 --oneline

# Install dependencies (production only)
RUN npm install --omit=dev

# Generate Prisma client
RUN npx prisma generate

# Expose port for Prisma Studio
EXPOSE 5555

# Run database migrations, then start Prisma Studio
# The DATABASE_URL environment variable must be set when running this container
CMD ["sh", "-c", "PRISMA_DATABASE_URL=$DATABASE_URL npx prisma migrate deploy && echo '✅ Database initialized successfully!' && PRISMA_DATABASE_URL=$DATABASE_URL npx prisma studio --browser none"]
